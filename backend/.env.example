# Generate strong values, e.g.:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me-too

# MongoDB Atlas (or local) connection string
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/fitness_db

# AI coach — Groq (free): https://console.groq.com/keys
GROQ_API_KEY=

# Deployed frontend URL(s), comma separated (localhost is always allowed)
# CORS_ORIGIN=https://your-app.vercel.app
CORS_ORIGIN=

# Set to "production" when deploying: the server then refuses to start with default secrets
# FLASK_ENV=production

# Optional — email members from the admin portal (any SMTP provider, e.g. Gmail app password, Brevo, Mailgun)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=Aivo <no-reply@example.com>
