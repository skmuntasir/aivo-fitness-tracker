SECRET_KEY=replace_with_a_long_random_string
JWT_SECRET_KEY=replace_with_another_long_random_string

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/fitness_db?retryWrites=true&w=majority

# AI — Google Gemini (FREE): https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Groq API key (if using Groq instead of Gemini)
GROQ_API_KEY=your_groq_api_key_here

# Your deployed frontend URL (set this after deploying to Vercel)
# Example: CORS_ORIGIN=https://your-app.vercel.app
CORS_ORIGIN=
